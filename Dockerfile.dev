FROM node:22-alpine

# development server (ng serve) as an unprivileged user
# /app/.angular (the build cache) and /app/node_modules are mounted as volumes in docker-compose: they must exist
# and belong to `node`, otherwise the unprivileged dev server cannot write the cache into the bind mount
RUN mkdir -p /app/.angular /app/node_modules && chown -R node:node /app
WORKDIR /app
USER node

COPY --chown=node:node package*.json ./
RUN npm ci

COPY --chown=node:node . .

EXPOSE 4200

CMD ["npm", "run", "serve"]
